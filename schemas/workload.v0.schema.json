{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GATGET-Security/Ai-linux/schemas/workload.v0.schema.json",
  "title": "AI Linux workload manifest v0",
  "description": "Declarative description of one benchmark workload.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ailx.workload/v0"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "synthetic",
        "llm-single",
        "llm-serving",
        "embeddings",
        "asr",
        "image",
        "video",
        "fine-tune",
        "model-load",
        "mixed"
      ]
    },
    "description": {
      "type": "string"
    },
    "adapter": {
      "enum": [
        "synthetic",
        "llama-bench",
        "vllm-bench-serve"
      ]
    },
    "params": {
      "type": "object"
    },
    "model": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "type": [
            "string",
            "null"
          ]
        },
        "lossy_vs_reference": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "binary"
      ],
      "properties": {
        "binary": {
          "type": "string"
        },
        "bundle_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "server": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "output_len_policy": {
      "enum": [
        "fixed",
        "natural",
        "n/a"
      ]
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "unit",
          "better"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "better": {
            "enum": [
              "higher",
              "lower"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "warmup_runs": {
      "type": "integer",
      "minimum": 0
    },
    "timeout_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "telemetry": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "name",
    "version",
    "type",
    "adapter",
    "params",
    "runtime",
    "output_len_policy",
    "metrics",
    "warmup_runs",
    "timeout_s"
  ],
  "additionalProperties": false
}

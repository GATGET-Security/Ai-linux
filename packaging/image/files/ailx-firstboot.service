# SPDX-License-Identifier: MIT
[Unit]
Description=AI Linux first boot: per-machine SSH host keys and data directories
DefaultDependencies=no
RequiresMountsFor=/data /var/lib/ailx /home
Before=ssh.service ssh.socket sshd-keygen.service
After=local-fs.target
ConditionPathExists=!/data/ssh/ssh_host_ed25519_key

[Service]
Type=oneshot
ExecStart=/usr/libexec/ailx/ailx-firstboot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
